# ============================================================
# Supabase (Project Settings -> API)
# Leave these BLANK to run in local demo mode (in-memory data,
# mocked AI). The app works fully without credentials.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server components / API routes for
# privileged reads (e.g. admin analytics). Never exposed to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Claude API (console.anthropic.com -> API Keys)
# Server-only. Leave BLANK to use the deterministic local matcher
# and template cover-letter generator instead.
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5